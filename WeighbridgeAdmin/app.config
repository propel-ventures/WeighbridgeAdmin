<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <!-- LocalDB is the default for a development machine.  For a real site this
         points at the site server, e.g.
         Data Source=WBSERVER01\SQLEXPRESS;Initial Catalog=WeighbridgeDb;User ID=wbapp;Password=... -->
    <add name="WeighbridgeDb"
         connectionString="Data Source=localhost\SQLEXPRESS;Initial Catalog=WeighbridgeDb;Integrated Security=True;Connect Timeout=15"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="SiteName" value="Riverstone Quarries - Site 04" />
    <add key="GstRate" value="0.10" />
  </appSettings>
</configuration>
